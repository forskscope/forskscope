# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
#Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Custom
docs/book
# Generated RFC index (mdbook output, same class as docs/book). F64 recorded
# it as build output that should be ignored; leaving it neither tracked nor
# ignored got it committed by accident twice, in e6fe8e6 and b79d9d0.
rfcs/index.html
/.git-exclude/
*.local.json

# packaging/render_check.py (F34) is run directly with python3, not installed
__pycache__/
