# RFC-101 stage B (handoff 114): dynamic-lookup ids, read from a
# `&'static str` field in another crate (forskscope-compare's
# BIDI_CONTROLS, forskscope-ui-logic's theme/contrast SelectChoice) at a
# handful of call sites, rather than a literal t(lang, "id") the i18n
# audit's static scan can see — tested directly against this table
# (i18n/mod.rs's own dynamic-lookup tests), not a copy of it.
bidi-alm = Arabic letter mark character
bidi-lrm = left-to-right mark character
bidi-rlm = right-to-left mark character
bidi-lre = left-to-right embedding character
bidi-rle = right-to-left embedding character
bidi-pdf = pop directional formatting character
bidi-lro = left-to-right override character
bidi-rlo = right-to-left override character
bidi-lri = left-to-right isolate character
bidi-rli = right-to-left isolate character
bidi-fsi = first strong isolate character
bidi-pdi = pop directional isolate character
theme-choice-system = System
theme-choice-system-unavailable = System (not available here; Dark is used)
theme-choice-dark = Dark
theme-choice-light = Light
theme-choice-night = Night
contrast-choice-system = System
contrast-choice-standard = Standard
contrast-choice-high = High

# i18n/mod.rs's own unit-test fixtures only - no real call site uses
# these ids (the test functions that do are themselves their "used"
# call site, so `cargo xtask i18n`'s "no unused message" check sees
# them as used, not orphaned).
test-fixture-plain = Plain test message
test-fixture-placeholder = Hello, { $name }!
test-fixture-plural.one = { $count } test item
test-fixture-plural.other = { $count } test items

# RFC-101 stage B (handoff 114), reply 198 S2: the ~18 assembled messages,
# rewritten as whole sentences. settings-incompatible-schema and
# session-incompatible-schema (items 2, 5) keep TODAY's wording verbatim
# - flagged for the owner's review (202a) - every other one below uses
# the architect-approved rewrite (review 232 S3.2).
settings-incompatible-schema = This settings file uses "{ $schema }" schema version { $version }, which this version of ForskScope does not understand. The file has not been modified. Changes you make this session will not be saved.
settings-corrupt-preserved = The settings file is preserved but could not be parsed ({ $detail }). Changes you make this session will not be saved unless you reset it.
settings-migration-failed = Your settings were read and are in use for this session, but they could not be saved in the new format ({ $detail }). Changes will not be saved until this is resolved.
session-incompatible-schema = This session file uses "{ $schema }" schema version { $version }, which this version of ForskScope does not understand. The file has not been modified. Changes you make this session will not be saved.
session-corrupt-preserved = The session file is preserved but could not be parsed ({ $detail }). Changes you make this session will not be saved unless you reset it.
session-migration-failed = Your session was read and is in use for this run, but it could not be saved in the new format ({ $detail }). Changes will not be saved until this is resolved.
toolbar-inline-diff-state = Inline diff: { $state }
toolbar-wrap-state = Wrap: { $state }
toolbar-ignore-whitespace-state = Ignore whitespace: { $state }
toolbar-ignore-case-state = Ignore case: { $state }

# Items 12-14 (reply 198 S2): FLAGGED for the owner's wording review
# (202a) - Japanese kept exactly as it reads today until approved.
batch-copy-confirm-title = Copy { $count } files?
batch-result-all-succeeded-title = Copied { $count } files
batch-result-partial-title = Copy finished: { $succeeded } succeeded, { $failed } failed

# Item 17 (reply 198 S2, review 232 S3.3): the Deep Compare summary is a
# list of independent, plural-aware messages, joined by a translated
# separator - never one joined `format!`. FLAGGED for the owner (202a):
# wording and the Japanese separator both kept exactly as they read today
# until approved - these English forms already read the same under
# either plural category, so giving them real one/other forms here is
# not itself a wording change.
deep-compare-different-count.one = { $count } different
deep-compare-different-count.other = { $count } different
deep-compare-equal-count.one = { $count } equal
deep-compare-equal-count.other = { $count } equal
deep-compare-left-only-count.one = { $count } left only
deep-compare-left-only-count.other = { $count } left only
deep-compare-right-only-count.one = { $count } right only
deep-compare-right-only-count.other = { $count } right only
deep-compare-unreadable-count.one = { $count } unreadable
deep-compare-unreadable-count.other = { $count } unreadable
deep-compare-list-separator = ·

# Items 15-16 (reply 198 §2): FLAGGED - today's wording kept until the
# owner approves (202a).
deep-compare-copy-to-right-title = Copy to right { $count } files
deep-compare-copy-to-right-short = Copy to right { $count }
deep-compare-copy-to-left-title = Copy to left { $count } files
deep-compare-copy-to-left-short = Copy to left { $count }

# Item 1 (reply 198 §2): not flagged - architect-approved rewrite
# (punctuation/placement only, no meaning change). Two whole-sentence
# variants, chosen by whether the error needs the access-guidance
# sentence, rather than joining a second translated piece onto the first.
could-not-open-error = Could not open "{ $name }": { $error }.
could-not-open-error-with-guidance = Could not open "{ $name }": { $error }. Check that the file exists and you have read permission.

# Item 18 (reply 198 §2): not flagged - consolidates the spreadsheet
# warning's sentence and the "Sheets:"/detail suffixes into one catalog
# entry per combination, instead of translated pieces glued by push_str.
warning-duplicate-alignment-key-with-sheets = Some rows share an alignment key, so rows may be paired wrongly. Sheets: { $names }
warning-alignment-fell-back-with-sheets = A sheet was too large to align rows and was compared position by position, so an inserted row may appear as many changes. Sheets: { $names }
warning-ambiguous-sheet-match-with-sheets = Several sheets could have been renamed, so none was matched; they appear as added and removed. Sheets: { $names }
warning-sheet-not-compared-with-sheets = Not compared (not a worksheet): { $names }
warning-other-detail = The comparison reported a warning: { $detail }
warning-other-detail-with-sheets = The comparison reported a warning: { $detail } Sheets: { $names }
warning-other-with-sheets = The comparison reported a warning: Sheets: { $names }

# RFC-101 §2's own flagship example: real CLDR plurals instead of a
# hand-rolled if/else (search.rs).
search-matches.one = { $count } match
search-matches.other = { $count } matches

contains-direction-control-characters.one = Contains { $count } direction-control character
contains-direction-control-characters.other = Contains { $count } direction-control characters

# RFC-101 stage B, review 232 §3.5: forskscope-report's own tr()
# closure (html.rs) is added to RFC-101's Touches - these ids are
# used only through that closure (forskscope-report has no access
# to this crate's t()/tf() directly; it calls a caller-supplied
# &dyn Fn(&str) -> String), so they're exempt from this crate's own
# audit's unused-message check the same way the dynamic-lookup ids
# are (see xtask's DYNAMIC_LOOKUP_IDS).
report-compare-profile = Compare profile
report-comparison-report = Comparison report
report-files = Files
report-generated = Generated
